# backend/.env örneği. Bu dosyayı .env adıyla kopyalayıp doldurun.
# .env GitHub'a GÖNDERİLMEZ (.gitignore'da); bu örnek dosya gönderilir.

# Veritabanı ve giriş (A)
DATABASE_URL=postgresql://postgres:SIFRE@127.0.0.1:5433/voyageai_db
JWT_SECRET=en-az-32-karakterlik-rastgele-bir-metin
DEV_MODE=true
COOKIE_SECURE=false

# ---- AI asistan (B, 5. hafta) ----
# OpenAI uyumlu herhangi bir servis olur. Üçü boşsa asistan kurallarla çalışır.
#
# Seçenek 1: Google Gemini (anahtar: https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Virgülle birden çok model yazılabilir: ilki yoğunsa (503) sıradaki denenir.
LLM_MODEL=birinci-gemini-modeli,yedek-gemini-modeli
LLM_API_KEY=
# Gemini'nin düşünen modellerinde cevabı hızlandırır (istersen sil):
LLM_REASONING_EFFORT=low
#
# Seçenek 2: Groq (anahtar: https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=
#
# Model adını bilmiyorsan:  python llm_dene.py --modeller
# Bağlantıyı denemek için:  python llm_dene.py
